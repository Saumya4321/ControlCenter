max_power = 1
cycle_time = 0.1

[fan_generic chamber_heater3]
pin = PB10
max_power = 1
cycle_time = 0.1

[fan_generic chamber_heater4]
pin = PB11
max_power = 1
cycle_time = 0.1

[fan_generic chamber_heater5]
pin = PA1
max_power = 1
cycle_time = 0.1

[fan_generic chamber_heater6]
pin = mcu1: PA0
max_power = 1
cycle_time = 0.1

[fan_generic chamber_heater7]
