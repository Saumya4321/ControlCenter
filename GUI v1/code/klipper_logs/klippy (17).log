[heater_bed]
heater_pin = mcu2: PA8
control = watermark
min_temp = -100
max_temp = 400
smooth_time = 0.5
sensor_pin = PF3
sensor_type = PT1000
max_power = 1

[verify_heater heater_bed]
max_error = 120000
check_gain_time = 200000
hysteresis = 0.2
heating_gain = 2

[heater_generic bed_heater1]
