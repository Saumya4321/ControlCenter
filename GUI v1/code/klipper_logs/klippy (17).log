[gcode_macro heater_off]
gcode = 
	SET_FAN_SPEED FAN=chamber_heater2 SPEED=0.0
	SET_FAN_SPEED FAN=chamber_heater3 SPEED=0.0
	SET_FAN_SPEED FAN=chamber_heater4 SPEED=0.0
	SET_FAN_SPEED FAN=chamber_heater5 SPEED=0.0
	SET_FAN_SPEED FAN=chamber_heater6 SPEED=0.0
	SET_FAN_SPEED FAN=chamber_heater7 SPEED=0.0
	SET_FAN_SPEED FAN=chamber_heater11 SPEED=0.0
	SET_FAN_SPEED FAN=chamber_heater12 SPEED=0.0

[gcode_macro M15]
gcode = 
	{% if params.D %}
	SET_FAN_SPEED FAN=chamber_heater2 SPEED={params.D|float}
	SET_FAN_SPEED FAN=chamber_heater3 SPEED={params.D|float}
	SET_FAN_SPEED FAN=chamber_heater4 SPEED={params.D|float}
	{% endif %}
	{% if params.B %}
	SET_FAN_SPEED FAN=chamber_heater5 SPEED={params.B|float}
	SET_FAN_SPEED FAN=chamber_heater6 SPEED={params.B|float}
	SET_FAN_SPEED FAN=chamber_heater7 SPEED={params.B|float}
	{% endif %}
	{% if params.C %}
	SET_FAN_SPEED FAN=chamber_heater11 SPEED={params.C|float}
	{% endif %}
	{% if params.A %}
	SET_FAN_SPEED FAN=chamber_heater12 SPEED={params.A|float}
	{% endif %}

[output_pin roller_start_stop]
