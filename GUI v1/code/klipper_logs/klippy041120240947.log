[gcode_macro list_sensors]
gcode = 
	{ action_respond_info(printer.heaters.available_heaters | join(', ')) }
	{ action_respond_info(printer.heaters.available_sensors | join(', ')) }

[idle_timeout]
timeout = 40000
gcode = 
	{% if printer["left_limit_switch"].triggered or printer["right_limit_switch"].triggered %}
	RESPOND TYPE=echo MSG="Limit Switch Triggered"
	recoater_stop
	roller_stop
	{% endif %}

[force_move]
enable_force_move = True

[heater_bed]
heater_pin = mcu2: PA8
control = watermark
min_temp = -100
max_temp = 400
smooth_time = 0.5
sensor_pin = PF3
sensor_type = PT1000
max_power = 1

[verify_heater heater_bed]
max_error = 120000
check_gain_time = 200000
hysteresis = 0.2
heating_gain = 2

[heater_generic bed_heater1]
gcode_id = B1
heater_pin = mcu2: PE5
sensor_pin = PF4
sensor_type = PT1000
control = watermark
min_temp = -100
max_temp = 300
smooth_time = 0.5
max_power = 1

[verify_heater bed_heater1]
max_error = 120000
check_gain_time = 200000
heating_gain = 2
hysteresis = 0.2

[gcode_macro RUN_TCP_CLIENT]
gcode = 
	RESPOND PREFIX="info" MSG="Running TCP client..."
	SHELL_COMMAND /path/to/run_tcp_client.sh
	RESPOND PREFIX="info" MSG="TCP client finished."

[gcode_macro dose_and_go_right_side]
gcode = 
	FORCE_MOVE stepper=stepper_z distance=10.12 velocity=2.5
	G4 P1000
	FORCE_MOVE stepper=stepper_z distance=-10.0 velocity=2.5
	
	G4 P500
	FORCE_MOVE stepper=stepper_x distance=10 velocity=28
	G4 P200
	FORCE_MOVE stepper=stepper_x distance=-11 velocity=28
	G4 P1000
	recoater_go_right
	RESPOND TYPE=echo MSG="Next Click go left side"
	SAVE_VARIABLE VARIABLE=recoater_position VALUE={1|int}

[gcode_macro dose_and_go_left_side]
gcode = 
	FORCE_MOVE stepper=stepper_z distance=10.12 velocity=2.5
	G4 P1000
	FORCE_MOVE stepper=stepper_z distance=-10.0 velocity=2.5
	
	G4 P500
	FORCE_MOVE stepper=dual_carriage distance=8 velocity=28
	G4 P200
	FORCE_MOVE stepper=dual_carriage distance=-9 velocity=28
	G4 P1000
	recoater_go_left
	RESPOND TYPE=echo MSG="Next Click go right side"
	SAVE_VARIABLE VARIABLE=recoater_position VALUE={0|int}

[gcode_macro toggle_recoat]
gcode = 
	{% if printer.save_variables.variables.recoater_position == 0 %}
	
	RECOATER_GO_RIGHT
	RESPOND TYPE=echo MSG="Recoater Going Right"
	{% elif printer.save_variables.variables.recoater_position == 1 %}
	
	RECOATER_GO_LEFT
	RESPOND TYPE=echo MSG="Recoater Going Left"
	{% endif %}

[gcode_macro toggle_recoat_powder_move_Z]
gcode = 
	{% set layers = printer.save_variables.variables.layers | default(0) %}
	
	{% if printer.save_variables.variables.recoater_position == 0 %}
	
	dose_and_go_right_side
	RESPOND TYPE=echo MSG="Recoater Going Right"
	{% elif printer.save_variables.variables.recoater_position == 1 %}
	
	dose_and_go_left_side
	RESPOND TYPE=echo MSG="Recoater Going Left"
	{% endif %}
	
	
	{% set layers = layers + 1 %}
	SAVE_VARIABLE VARIABLE=layers VALUE={layers}
	RESPOND TYPE=echo MSG="Number of layers is {layers}"

[gcode_macro ZERO_LAYERS]
gcode = 
	{% set svv = printer.save_variables.variables %}
	SAVE_VARIABLE VARIABLE=layers VALUE=0
	RESPOND TYPE=echo MSG="Layers have been reset to 0"

[board_pins]
aliases = 
	
	EXP1_1=PE8, EXP1_2=PE7,
	EXP1_3=PE9, EXP1_4=PE10,
	EXP1_5=PE12, EXP1_6=PE13,
	EXP1_7=PE14, EXP1_8=PE15,
	EXP1_9=<GND>, EXP1_10=<5V>,
	
	
	EXP2_1=PA6, EXP2_2=PA5,
	EXP2_3=PB1, EXP2_4=PA4,
	EXP2_5=PB2, EXP2_6=PA7,
	EXP2_7=PC15, EXP2_8=<RST>,
	EXP2_9=<GND>, EXP2_10=<5V>
