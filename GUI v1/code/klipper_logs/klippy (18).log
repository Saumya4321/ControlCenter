===== Config file =====
[virtual_sdcard]
on_error_gcode = CANCEL_PRINT
path = ~/printer_data/gcodes

[fan_generic chamber_heater2]
pin = PA3
max_power = 1
cycle_time = 0.1

[fan_generic chamber_heater3]
pin = PB10
max_power = 1
cycle_time = 0.1

[fan_generic chamber_heater4]
pin = PB11
max_power = 1
cycle_time = 0.1

[fan_generic chamber_heater5]
pin = PA1
max_power = 1
cycle_time = 0.1

[fan_generic chamber_heater6]
pin = mcu1: PA0
max_power = 1
cycle_time = 0.1

[fan_generic chamber_heater7]
pin = mcu1: PA3
max_power = 1
cycle_time = 0.1

[fan_generic chamber_heater11]
pin = mcu2: PA0
max_power = 1
cycle_time = 0.1

[fan_generic chamber_heater12]
pin = mcu2: PA3
max_power = 1
cycle_time = 0.1

[gcode_macro heater_off]
gcode = 
	SET_FAN_SPEED FAN=chamber_heater2 SPEED=0.0
	SET_FAN_SPEED FAN=chamber_heater3 SPEED=0.0
	SET_FAN_SPEED FAN=chamber_heater4 SPEED=0.0
	SET_FAN_SPEED FAN=chamber_heater5 SPEED=0.0
	SET_FAN_SPEED FAN=chamber_heater6 SPEED=0.0
	SET_FAN_SPEED FAN=chamber_heater7 SPEED=0.0
	SET_FAN_SPEED FAN=chamber_heater11 SPEED=0.0
	SET_FAN_SPEED FAN=chamber_heater12 SPEED=0.0

[gcode_macro M15]
gcode = 
	{% if params.D %}
	SET_FAN_SPEED FAN=chamber_heater2 SPEED={params.D|float}
	SET_FAN_SPEED FAN=chamber_heater3 SPEED={params.D|float}
	SET_FAN_SPEED FAN=chamber_heater4 SPEED={params.D|float}
	{% endif %}
	{% if params.B %}
	SET_FAN_SPEED FAN=chamber_heater5 SPEED={params.B|float}
	SET_FAN_SPEED FAN=chamber_heater6 SPEED={params.B|float}
	SET_FAN_SPEED FAN=chamber_heater7 SPEED={params.B|float}
	{% endif %}
	{% if params.C %}
	SET_FAN_SPEED FAN=chamber_heater11 SPEED={params.C|float}
	{% endif %}
	{% if params.A %}
	SET_FAN_SPEED FAN=chamber_heater12 SPEED={params.A|float}
	{% endif %}

[duplicate_pin_override]
pins = mcu1:PF3

[output_pin roller_start_stop]
pin = PE5
value = 0
shutdown_value = 0

[output_pin roller_run_break]
pin = PD12
value = 0
shutdown_value = 0

[output_pin roller_fw_rev]
pin = PD13
value = 0
shutdown_value = 0

[output_pin roller_M1]
pin = PD14
value = 0
shutdown_value = 0

[gcode_macro roller_ccw]
gcode = 
	SET_PIN PIN=roller_start_stop VALUE=1
	SET_PIN PIN=roller_run_break VALUE=1
	SET_PIN PIN=roller_fw_rev VALUE=1
	SET_PIN PIN=my_pwm VALUE=0.5
	SET_PIN PIN=roller_M1 VALUE=1

[gcode_macro roller_cw]
gcode = 
	SET_PIN PIN=roller_start_stop VALUE=1
	SET_PIN PIN=roller_run_break VALUE=1
	SET_PIN PIN=roller_fw_rev VALUE=0
	SET_PIN PIN=my_pwm VALUE=0.5
	SET_PIN PIN=roller_M1 VALUE=1

[gcode_macro roller_stop]
gcode = 
	SET_PIN PIN=roller_start_stop VALUE=0
	SET_PIN PIN=roller_run_break VALUE=1
	SET_PIN PIN=roller_fw_rev VALUE=1
	SET_PIN PIN=my_pwm VALUE=0
	SET_PIN PIN=roller_M1 VALUE=1

